# LLM + embeddings
OPENAI_API_KEY=sk-...

# Data sources (fallback chain: yfinance → Massive → Twelve Data → EODHD → Tiingo)
ALPHA_VANTAGE_API_KEY=...
MASSIVE_API_KEY=...
TWELVEDATA_API_KEY=...
EODHD_API_KEY=...
# Also accepts EODHd_API_KEY (legacy)
TIINGO_API_KEY=...

# Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=...
LANGCHAIN_PROJECT=finsight

# Database
DATABASE_URL=postgresql+asyncpg://finsight:finsight@localhost:5433/finsight

# Redis
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8100

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256

# AWS (local only — EC2 uses instance profile)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1
